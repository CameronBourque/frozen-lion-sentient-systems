{
  "name": "frozen-lion-sentient-systems",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=26"
  },
  "workspaces": [
    "packages/core/bridge"
  ],
  "scripts": {
    "check-docs": "node scripts/check-docs/src/index.mjs",
    "coverage": "npm run coverage:lua && vitest run --coverage",
    "coverage:lua": "node scripts/clean-lua-fixtures/src/index.mjs && node scripts/lua-coverage/src/index.mjs",
    "dev": "npm run dev --workspace packages/core/bridge",
    "link-mod": "node scripts/link-mod/src/index.mjs",
    "state": "npm run state --workspace packages/core/bridge --",
    "lint": "eslint . && node scripts/lua-comments/src/index.mjs",
    "test": "vitest run",
    "test:lua": "node scripts/clean-lua-fixtures/src/index.mjs && busted",
    "typecheck": "npm run typecheck --workspaces --if-present"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@stylistic/eslint-plugin": "^5.10.0",
    "@types/node": "^26.6.6",
    "@vitest/coverage-v8": "^5.0.5",
    "esbuild": "^0.28.2",
    "eslint": "^10.14.0",
    "globals": "^17.14.0",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.1",
    "vitest": "^5.0.5"
  }
}
