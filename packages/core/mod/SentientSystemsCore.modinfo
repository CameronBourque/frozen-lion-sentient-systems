<?xml version="1.0" encoding="utf-8"?>
<Mod id="5D4B5856-E71F-492C-A434-A0938AF49451" version="0.3.0"> <!-- x-release-please-version -->
	<Properties>
		<Name>Sentient Systems Core</Name>
