{
  "$schema": "https://raw.githubusercontent.com/googleapis/release-please/main/schemas/config.json",
  "release-type": "simple",
  "bump-minor-pre-major": true,
  "include-component-in-tag": true,
  "packages": {
    "packages/core": {
      "component": "core",
      "extra-files": [
        { "type": "json", "path": "bridge/package.json", "jsonpath": "$.version" },
        "mod/Scripts/Version.lua"
      ]
    },
    "packages/agents": {
      "component": "agents",
      "extra-files": ["Scripts/Version.lua"]
    },
    "packages/advisors": {
      "component": "advisors",
      "extra-files": ["Scripts/Version.lua"]
    }
  }
}
