{
  "$schema": "https://raw.githubusercontent.com/googleapis/release-please/main/schemas/config.json",
  "release-type": "simple",
  "initial-version": "0.1.0",
  "bump-minor-pre-major": true,
  "include-component-in-tag": true,
  "packages": {
    "packages/core": {
      "component": "core",
      "extra-files": [
        { "type": "json", "path": "bridge/package.json", "jsonpath": "$.version" },
        { "type": "json", "path": "/package-lock.json", "jsonpath": "$.packages['packages/core/bridge'].version" },
        "mod/SentientSystemsCore.modinfo"
      ]
    },
    "packages/agents": {
      "component": "agents",
      "exclude-paths": ["packages/agents/Scripts"]
    },
    "packages/advisors": {
      "component": "advisors",
      "exclude-paths": ["packages/advisors/Scripts"]
    }
  }
}
